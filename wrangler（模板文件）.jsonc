{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Values marked with DEPLOY_* below are placeholders for local/dev.
  // CLI deploy (pnpm deploy:worker / deploy:config) rewrites them into gitignored wrangler.deploy.jsonc.
  // Prefer setting DEPLOY_* in .env or Workers Builds / Pages variables — do not hardcode production IDs here.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "example" // 此处修改为你在CF内设置的名称，不想修改则为默认的：sink，对应教程的 DEPLOY_ANALYTICS_DATASET 变量
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "<填入你创建的KV的ID>", // 对应 DEPLOY_KV_PREVIEW_NAMESPACE_ID (或 DEPLOY_KV_NAMESPACE_ID)变量
      "id": "同上" // 对应 DEPLOY_KV_NAMESPACE_ID 变量
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sink", // 可自定义，否则为默认的sink，对应 DEPLOY_D1_DATABASE_NAME 变量
      "database_id": "<填入你创建的DB数据库ID>", // 对应教程的 DEPLOY_D1_DATABASE_ID 变量
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      // preview_bucket_name: DEPLOY_R2_PREVIEW_BUCKET_NAME (falls back to DEPLOY_R2_BUCKET_NAME)
      // omit DEPLOY_R2_BUCKET_NAME to drop R2 from generated deploy config
      "preview_bucket_name": "sink",
      "bucket_name": "sink" // 对应 DEPLOY_R2_BUCKET_NAME 变量
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
